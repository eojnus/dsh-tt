{
  "name": "@dsh-tt/roleplay",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Roleplay (SillyTavern-compatible) workspace for DeepSeek Harness",
  "exports": {
    ".": "./index.js",
    "./agent": "./agent.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "agent.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
